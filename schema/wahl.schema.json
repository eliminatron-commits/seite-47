{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Seite 47 – Wahl-Datensatz",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "region",
    "wahltag",
    "parteien",
    "themen"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2,
      "description": "2 = Fragen mit 3–4 Aussagen und Beste/Schlechteste-Auswahl. 1 war eine Aussage je Partei und Thema mit Zustimmung/Neutral/Ablehnung."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "wahltag": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "stand": {
      "type": "string",
      "description": "Datum der Datenerhebung (ISO)."
    },
    "platzhalter": {
      "type": "boolean",
      "description": "true = noch keine echten Programminhalte."
    },
    "parteien": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "farbe",
          "programm"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "farbe": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Erst ab der Aufdeckung verwendet."
          },
          "alias": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Weitere Selbstbezeichnungen. Name und Aliasse werden vor der Aufdeckung in Aussagetexten maskiert, weil Originalzitate die eigene Partei nennen."
          },
          "logo": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pfad unter assets/logos/, erst ab der Aufdeckung geladen."
          },
          "programm": {
            "type": "object",
            "required": [
              "titel",
              "datei"
            ],
            "additionalProperties": false,
            "properties": {
              "titel": {
                "type": "string"
              },
              "datei": {
                "type": "string",
                "description": "Pfad zum PDF im Repository."
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Fundort der Originaldatei (Dokumentation)."
              }
            }
          }
        }
      }
    },
    "themen": {
      "type": "array",
      "minItems": 1,
      "description": "Richtwert 8–12 Themen, je Wahl unabhängig aus den Programmen abgeleitet.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "titel",
          "fragen"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "titel": {
            "type": "string"
          },
          "beschreibung": {
            "type": "string"
          },
          "fragen": {
            "type": "array",
            "minItems": 1,
            "description": "Ein Thema hat mehrere Fragen. Über alle Fragen eines Themas soll jede Partei gleich oft vorkommen (Abweichung höchstens 1), damit die Gruppierung das Ergebnis nicht steuert.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "aussagen"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-f[0-9]{3}$",
                  "description": "Undurchsichtig; erscheint im DOM."
                },
                "text": {
                  "type": "string",
                  "description": "Die Unterfrage, die alle Aussagen dieser Frage beantworten. Muss so eng sein, dass die Aussagen echte Alternativen sind – sonst ist ein Vergleich sinnlos."
                },
                "vorlaeufig": {
                  "type": "boolean",
                  "description": "true = maschinell gruppiert, redaktionell noch nicht geprüft."
                },
                "aussagen": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 4,
                  "description": "Höchstens eine Aussage je Partei innerhalb einer Frage.",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "parteiId",
                      "kurz",
                      "original",
                      "quelle"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z]{2}-a[0-9]{3}$",
                        "description": "Undurchsichtig: darf keinen Rückschluss auf die Partei zulassen (erscheint im DOM)."
                      },
                      "parteiId": {
                        "type": "string"
                      },
                      "kurz": {
                        "type": "string",
                        "description": "Vereinfachte Fassung, 2–3 Sätze. Standardanzeige. Innerhalb einer Frage müssen alle Fassungen in Länge, Ton und Konkretheit vergleichbar sein – sonst verrät der Stil die Partei."
                      },
                      "original": {
                        "type": "string",
                        "description": "Leicht gekürztes Originalzitat, inhaltsgleich zu 'kurz'."
                      },
                      "quelle": {
                        "type": "object",
                        "required": [
                          "datei",
                          "seite",
                          "markierung"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "datei": {
                            "type": "string"
                          },
                          "seite": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Seite im PDF (1-basiert, wie von PDF.js gezählt)."
                          },
                          "markierung": {
                            "type": "string",
                            "description": "Wörtlicher Textausschnitt, den der Viewer hervorhebt."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "begriffe": {
      "type": "array",
      "description": "Glossar: Fachwoerter aus den Fragetexten, je in ein bis zwei Saetzen erklaert. Nur Woerter, die in DIESEM Datensatz vorkommen; erzeugt aus der gemeinsamen Quelle .claude/quellen/begriffe.py. Markiert wird ausschliesslich der Fragetext, nie eine Aussage.",
      "items": {
        "type": "object",
        "required": [
          "wort",
          "erklaerung"
        ],
        "additionalProperties": false,
        "properties": {
          "wort": {
            "type": "string",
            "description": "Grundform, wie sie im Glossar steht."
          },
          "erklaerung": {
            "type": "string",
            "description": "Ein bis zwei Saetze, sachlich, ohne Partei und ohne Wertung."
          },
          "formen": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Schreibformen im Fragetext, laengste zuerst (\"Milieuschutzgebieten\" vor \"Milieuschutz\")."
          }
        }
      }
    }
  }
}
